{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "StatusMonitor": {
    "Url": "http://localhost:8080/customers/health",
    "IntervalSeconds": 60,
    "TimeoutSeconds": 10,
    "LogFileName": "status.log",
    "AllowUntrustedCertificate": false
  }
}
